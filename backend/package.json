{
  "name": "@comiccrawler/backend",
  "version": "0.3.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "cli": "ts-node src/cli-main.ts",
    "dev": "ts-node-dev --respawn src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npx playwright test --config=../playwright.config.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"tests-e2e/**/*.ts\""
  },
  "dependencies": {
    "@comiccrawler/browser-client-sdk": "*",
    "@comiccrawler/shared": "*",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "cheerio": "^1.0.0",
    "commander": "^11.0.0",
    "fastify": "^5.12.7",
    "i18next": "^23.0.0",
    "pino": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.0.0",
    "undici": "^6.29.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.0.0",
    "jest": "^29.0.0",
    "msw": "^2.0.0",
    "ts-jest": "^29.0.0",
    "ts-node-dev": "^2.0.0"
  }
}
